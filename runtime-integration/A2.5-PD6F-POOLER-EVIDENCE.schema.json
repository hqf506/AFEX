{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:afex:a2.5:pd6f:pooler-evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "scenario_count", "scenario_order", "endpoint_class", "evidence_tier",
    "pooler_product", "pooler_version", "pooler_mode", "driver_version", "postgres_version",
    "infrastructure_digest", "configuration_digest", "compatibility_checks", "results",
    "aggregate_pass", "canonical_digest"
  ],
  "properties": {
    "schema_version": { "const": "A2.5-PD6F-POOLER-1" },
    "scenario_count": { "const": 1 },
    "scenario_order": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "prefixItems": [{ "const": "PD6-D-032" }], "items": false
    },
    "endpoint_class": { "const": "PGBOUNCER_TRANSACTION_POOL" },
    "evidence_tier": { "const": "PD6F_POOLER" },
    "pooler_product": { "const": "PGBOUNCER" },
    "pooler_version": { "const": "1.25.2" },
    "pooler_mode": { "const": "TRANSACTION" },
    "driver_version": { "const": "8.22.0" },
    "postgres_version": { "type": "string", "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}(?:\\.[0-9]{1,3})?$", "maxLength": 32 },
    "infrastructure_digest": { "const": "4eebd2a034d9e8797bc2c2e147a90dc688fb49a3eac39f9d1ce3d0a298c1e1d6" },
    "configuration_digest": { "const": "2b87ed7f8f9303144fb37b93d6a6165ffcf1fbc169991c48cf5b5d8a3720ff4c" },
    "compatibility_checks": {
      "type": "array", "minItems": 12, "maxItems": 12,
      "prefixItems": [
        { "type": "object", "additionalProperties": false, "required": ["check_id", "pass"], "properties": { "check_id": { "const": "POOLER_BASELINE" }, "pass": { "const": true } } },
        { "type": "object", "additionalProperties": false, "required": ["check_id", "pass"], "properties": { "check_id": { "const": "UNNAMED_QUERY" }, "pass": { "const": true } } },
        { "type": "object", "additionalProperties": false, "required": ["check_id", "pass"], "properties": { "check_id": { "const": "TRANSACTION_COMMIT" }, "pass": { "const": true } } },
        { "type": "object", "additionalProperties": false, "required": ["check_id", "pass"], "properties": { "check_id": { "const": "ORDINARY_FAILURE_ROLLBACK" }, "pass": { "const": true } } },
        { "type": "object", "additionalProperties": false, "required": ["check_id", "pass"], "properties": { "check_id": { "const": "STATEMENT_TIMEOUT" }, "pass": { "const": true } } },
        { "type": "object", "additionalProperties": false, "required": ["check_id", "pass"], "properties": { "check_id": { "const": "RESULT_BEFORE_DEADLINE" }, "pass": { "const": true } } },
        { "type": "object", "additionalProperties": false, "required": ["check_id", "pass"], "properties": { "check_id": { "const": "DESTRUCTIVE_REPLACEMENT" }, "pass": { "const": true } } },
        { "type": "object", "additionalProperties": false, "required": ["check_id", "pass"], "properties": { "check_id": { "const": "CHECKOUT_CONTENTION" }, "pass": { "const": true } } },
        { "type": "object", "additionalProperties": false, "required": ["check_id", "pass"], "properties": { "check_id": { "const": "SANITATION_REACQUISITION" }, "pass": { "const": true } } },
        { "type": "object", "additionalProperties": false, "required": ["check_id", "pass"], "properties": { "check_id": { "const": "SHUTDOWN_BEFORE_BORROWER" }, "pass": { "const": true } } },
        { "type": "object", "additionalProperties": false, "required": ["check_id", "pass"], "properties": { "check_id": { "const": "NO_SESSION_AFFINITY" }, "pass": { "const": true } } },
        { "type": "object", "additionalProperties": false, "required": ["check_id", "pass"], "properties": { "check_id": { "const": "NO_NAMED_STATEMENTS" }, "pass": { "const": true } } }
      ],
      "items": false
    },
    "results": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "prefixItems": [{
        "type": "object", "additionalProperties": false,
        "required": [
          "scenario_id", "evidence_tier", "endpoint_class", "driver_version", "postgres_version",
          "terminal_classification", "release_action", "failure_code", "sqlstate",
          "transaction_status_before", "transaction_status_after", "rollback_attempts",
          "retry_attempted", "client_destroyed", "replacement_observed", "decoded_value_class", "pass"
        ],
        "properties": {
          "scenario_id": { "const": "PD6-D-032" },
          "evidence_tier": { "const": "PD6F_POOLER" },
          "endpoint_class": { "const": "PGBOUNCER_TRANSACTION_POOL" },
          "driver_version": { "const": "8.22.0" },
          "postgres_version": { "type": "string", "maxLength": 32 },
          "terminal_classification": { "const": "COMPLETED_SAFE" },
          "release_action": { "const": "NORMAL_RELEASE" },
          "failure_code": { "const": null },
          "sqlstate": { "const": null },
          "transaction_status_before": { "const": "IDLE" },
          "transaction_status_after": { "const": "IDLE" },
          "rollback_attempts": { "const": 0 },
          "retry_attempted": { "const": false },
          "client_destroyed": { "const": false },
          "replacement_observed": { "const": false },
          "decoded_value_class": { "const": "NOT_APPLICABLE" },
          "pass": { "const": true }
        }
      }],
      "items": false
    },
    "aggregate_pass": { "const": true },
    "canonical_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
